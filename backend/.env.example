# Copy to .env and fill in. .env itself is gitignored.
PORT=5000
# Local Docker MongoDB, started with: docker compose up -d
MONGODB_URI=mongodb://127.0.0.1:27018/seatly?directConnection=true
CORS_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
